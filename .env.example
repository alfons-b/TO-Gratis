# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA: hanya untuk server. JANGAN beri prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Kata sandi sekali pakai untuk halaman /setup (membuat akun admin pertama).
# Buat acak & panjang. Boleh dihapus setelah admin dibuat.
SETUP_SECRET=

# Identitas tampilan (nama & logo disediakan pemilik produk)
NEXT_PUBLIC_APP_NAME=Florata Academy
# Opsional: URL logo HTTPS atau path di /public, mis. /logo.png
NEXT_PUBLIC_LOGO_URL=/logo.png
